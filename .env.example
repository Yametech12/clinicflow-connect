# ClinicFlow Connect environment variables.
# Copy this file to .env locally, or set the same names in the Vercel
# project settings (Settings, Environment Variables) for production.
# Never commit real values.

# Central Meta app ID. Where to get: developers.facebook.com, My Apps,
# Create App (Business), the App ID is on the app dashboard.
META_APP_ID=

# Central Meta app secret. Where to get: same Meta app, Settings, Basic,
# App Secret (Show). Server only, never expose to the browser.
META_APP_SECRET=

# Webhook verify token. Where to get: invent any passphrase yourself and
# paste the same string into the Meta app webhook settings.
META_VERIFY_TOKEN=

# Central Google OAuth client ID. Where to get: console.cloud.google.com,
# APIs and Services, Credentials, Create Credentials, OAuth client ID
# (Web application). Add the deployed /api/callback/google URL as an
# authorized redirect URI.
GOOGLE_CLIENT_ID=

# Central Google OAuth client secret. Where to get: same OAuth client
# page in Google Cloud Console. Server only.
GOOGLE_CLIENT_SECRET=

# Gemini API key for the bot brain. Where to get:
# aistudio.google.com/app/apikey, Create API key.
GEMINI_API_KEY=

# Optional Gemini model override. Defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.5-flash-lite

# Central Telegram bot token. Where to get: Telegram, @BotFather,
# /newbot, copy the HTTP API token it gives you.
TELEGRAM_BOT_TOKEN=

# Central Telegram bot username, without the @ sign. Where to get: the
# username you chose with @BotFather for the same bot.
TELEGRAM_BOT_USERNAME=

# Optional secret token sent by Telegram in X-Telegram-Bot-Api-Secret-Token
# when setWebhook is configured with secret_token.
TELEGRAM_WEBHOOK_SECRET=

# HTTPS key-value store (Upstash Redis / Vercel KV REST API, free tier).
# Where to get: Upstash Console (upstash.com) or Vercel Marketplace -> Upstash Redis.
# Copy REST URL and REST Token (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
# are also accepted as aliases).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Local-only optional fallback JSON file path for offline testing without Upstash.
# Ignored when running on Vercel (VERCEL=1). Leave blank in production.
CLINICFLOW_LOCAL_STORE_FILE=
